rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    // ==================== LIVROS ====================
    function isValidLivro(data) {
      return data.keys().hasAll(['titulo', 'autor', 'quantidade']) &&
             data.titulo is string && data.titulo.size() > 0 && data.titulo.size() <= 200 &&
             data.autor is string && data.autor.size() > 0 && data.autor.size() <= 150 &&
             data.quantidade is number && data.quantidade >= 0;
    }

    match /livros/{livroId} {
      allow read: if true;
      allow create, update: if isValidId(livroId) && isValidLivro(incoming());
      allow delete: if isValidId(livroId);
    }

    // ==================== ALUNOS ====================
    function isValidAluno(data) {
      return data.keys().hasAll(['nome', 'matricula']) &&
             data.nome is string && data.nome.size() > 0 && data.nome.size() <= 150 &&
             data.matricula is string && data.matricula.size() > 0 && data.matricula.size() <= 50;
    }

    match /alunos/{alunoId} {
      allow read: if true;
      allow create, update: if isValidId(alunoId) && isValidAluno(incoming());
      allow delete: if isValidId(alunoId);
    }

    // ==================== EMPRÉSTIMOS ====================
    function isValidEmprestimo(data) {
      return data.keys().hasAll(['livroId', 'alunoId', 'dataEmprestimo', 'dataPrevista']) &&
             data.livroId is string && data.alunoId is string;
    }

    match /emprestimos/{emprestimoId} {
      allow read: if true;
      allow create, update: if isValidId(emprestimoId) && isValidEmprestimo(incoming());
      allow delete: if isValidId(emprestimoId);
    }

    // ==================== RESERVAS ====================
    function isValidReserva(data) {
      return data.keys().hasAll(['livroId', 'alunoId', 'status']) &&
             data.livroId is string && data.alunoId is string;
    }

    match /reservas/{reservaId} {
      allow read: if true;
      allow create, update: if isValidId(reservaId) && isValidReserva(incoming());
      allow delete: if isValidId(reservaId);
    }

    // ==================== AVALIAÇÕES ====================
    match /avaliacoes/{avaliacaoId} {
      allow read: if true;
      allow create, update: if isValidId(avaliacaoId) && incoming().nota is number;
      allow delete: if isValidId(avaliacaoId);
    }

    // ==================== FAVORITOS ====================
    match /favoritos/{favoritoId} {
      allow read: if true;
      allow create, update, delete: if isValidId(favoritoId);
    }

    // ==================== CONFIGURAÇÃO ====================
    match /config/{configId} {
      allow read: if true;
      allow create, update: if isValidId(configId);
    }

    // Default test connection probe
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
